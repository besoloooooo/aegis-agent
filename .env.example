# Copy this file to `.env` and fill in your values.  `.env` is gitignored.
# The CLI and OpenAICompatibleProvider.from_env() auto-load it (no export needed).

# Required for the real provider:
AEGIS_API_KEY=sk-your-key-here
AEGIS_MODEL=qwen-plus

# Optional; any OpenAI-compatible endpoint (OpenAI, OpenRouter, DashScope, Ollama, vLLM, ...):
AEGIS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
